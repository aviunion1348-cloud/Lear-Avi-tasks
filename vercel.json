{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "desktop",
          "format": "url",
          "env": "DESKTOP_URL"
        }
      ]
    },
    "desktop": {
      "root": "desktop",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/ws/(.*)", "destination": { "service": "app" } },
    { "source": "/demo/(.*)", "destination": { "service": "app" } },
    { "source": "/admin", "destination": { "service": "app" } },
    { "source": "/store", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "desktop" } }
  ]
}
